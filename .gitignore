# ========================
# Nirikshak-LM .gitignore
# ========================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
backend/venv/
backend/.venv/
venv/
.venv/

# --- Node / Next.js ---
frontend/node_modules/
frontend/.next/
frontend/out/

# --- Environment variables ---
.env
.env.local
.env.*.local

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Uploads / generated at runtime ---
uploads/
*.pdf
*.docx

# --- Dataset (large files, manage separately) ---
dataset/images/
dataset/annotations/

# --- Logs ---
*.log
