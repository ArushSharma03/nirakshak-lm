# ========================
# Nirikshak-LM .gitignore
# ========================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
backend/venv/
backend/.venv/
venv/
.venv/

# --- Node / Next.js ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/*.tsbuildinfo

# --- Environment variables & secrets ---
.env
.env.local
.env.*.local
.env*.local
*.env
!.env.example
*.pem
*.key
*.cert
*.crt

# --- Databases & Local Storage ---
*.sqlite
*.sqlite3
*.db
backend/data/images/
backend/data/*.json
backend/data/**/*.jpg
backend/data/**/*.png

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Uploads & Runtime-generated Artifacts ---
uploads/
*.pdf
*.docx
debug_temp.jpg
backend/debug_temp.jpg
temp_marker_*.png

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
coverage/

# --- Dataset (large files, manage separately) ---
dataset/images/
dataset/annotations/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
