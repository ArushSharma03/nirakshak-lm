# ==============================================================================
# Nirikshak-LM Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in appropriate values.
# Do NOT commit .env to version control.
# ==============================================================================

# --- Application ---
APP_NAME=Nirikshak-LM
APP_ENV=development
DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Local OCR and optional paid decisions ---
XIAOMI_OCR_ENABLED=true
OCR_DEVICE=cpu
OCR_MAX_TOKENS=1024
TESSERACT_LANGUAGES=eng
TYPESAFE_MODEL=jev-1.14.0
# Supply TYPESAFE_API_KEY through a server-side secret manager.
# Jev also requires explicit use_jev=true per analysis request.

# --- Database (Step 2) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nirikshak_lm

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Object Storage (future) ---
# UPLOAD_DIR=./uploads

# --- Authentication (future) ---
# SECRET_KEY=change-this-to-a-random-secret
# ACCESS_TOKEN_EXPIRE_MINUTES=60
